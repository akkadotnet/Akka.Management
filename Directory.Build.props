<Project>
  <PropertyGroup>
    <Copyright>Copyright © 2013-$([System.DateTime]::Now.Year) Akka.NET Team</Copyright>
    <Authors>Akka.NET Team</Authors>
    <VersionPrefix>1.6.0-beta5</VersionPrefix>
    <PackageReleaseNotes>* Built against [Akka.NET v1.6.0-beta5](https://github.com/akkadotnet/akka.net/releases/tag/1.6.0-beta5) and Akka.Hosting 1.6.0-beta5.
* Bumped to Akka.NET 1.6.0-beta4 in [#3502](https://github.com/akkadotnet/Akka.Management/pull/3502), which also raised Aspire to 13.6.4 and pinned MessagePack to 2.5.307 to clear the NU1902 advisory (GHSA-qhrr-8q5h-9q3h). Warnings are errors here, so the build failed without it.
* NuGet publishing moves to GitHub Actions trusted publishing, replacing the Windows release pipeline. ([#3500](https://github.com/akkadotnet/Akka.Management/pull/3500))
* Bumped to Akka.NET and Akka.Hosting 1.6.0-beta5 in [#3504](https://github.com/akkadotnet/Akka.Management/pull/3504). No other pins needed changing: beta5 keeps the MessagePack 3.1.12 and Google.Protobuf 3.36.2 that beta4 brought in.</PackageReleaseNotes>
    <PackageIcon>akkalogo.png</PackageIcon>
    <PackageProjectUrl>https://github.com/akkadotnet/Akka.Management</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <NoWarn>$(NoWarn);CS1591;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Embed the package icon (replaces the deprecated PackageIconUrl); matches akka.net / Akka.Hosting. -->
    <None Include="$(MSBuildThisFileDirectory)\docs\images\akkalogo.png" Pack="true" Visible="false" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Fail the build on ALL NuGet audit advisories (moderate/high/critical). -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <AkkaPackageTags>akka;actors;actor model;Akka;concurrency;service discovery;cluster;clustering;</AkkaPackageTags>
    <LibraryFramework>net10.0</LibraryFramework>
    <TestsNet>net10.0</TestsNet>
  </PropertyGroup>
  <!-- SourceLink support for all Akka.NET projects -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Optional: Embed source files that are not tracked by the source control manager in the PDB -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Optional: Build symbol package (.snupkg) to distribute the PDB containing Source Link -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>